# Supabase Configuration (Public Anon Key only for browser / client requests)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Security Notice: Ordinary user operations NEVER require a service_role key.
# Do NOT place a service_role key in public environment variables or client code.
# SUPABASE_SERVICE_ROLE_KEY is reserved strictly for trusted server-side tasks (e.g. iOS ingest-token validation).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application Security
# Optional custom HMAC session secret for session cookie signing
SESSION_SECRET=your-secure-random-32-character-secret

# Demo Mode Toggle (Defaults to true in development, false in production)
ENABLE_DEMO_MODE=false

# Optional
NEXT_PUBLIC_SITE_URL=http://localhost:3000
